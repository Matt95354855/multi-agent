{
  "name": "@classcale/multi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "bin": { "classcale-agents": "dist/src/cli/index.js" },
  "scripts": {
    "bootstrap:harness": "npm --prefix vendor/harness ci && npm --prefix vendor/harness run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/security/*.test.ts tests/e2e/*.test.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --reporter=text --reporter=lcov npm test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/src/cli/index.js",
    "doctor": "tsx src/cli/index.ts doctor",
    "benchmark": "tsx src/cli/index.ts benchmark --config config/default.json"
  },
  "dependencies": {
    "@matt95354855/agent-harness": "file:vendor/harness",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
