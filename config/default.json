{
  "models": {
    "gpt-oss": { "kind": "managed", "executable": "llama-server", "modelPathEnv": "GPT_OSS_MODEL_PATH", "endpoint": "http://127.0.0.1:8080/v1", "port": 8080, "contextSize": 4096, "gpuLayers": 20, "threads": 8, "extraArgs": ["--fit", "on", "--parallel", "1"], "startupTimeoutMs": 180000 },
    "qwen": { "kind": "managed", "executable": "llama-server", "modelPathEnv": "QWEN_MODEL_PATH", "endpoint": "http://127.0.0.1:8081/v1", "port": 8081, "contextSize": 2048, "gpuLayers": 16, "threads": 8, "extraArgs": ["--fit", "on", "--parallel", "1"], "startupTimeoutMs": 180000 }
  },
  "roles": { "planner": "gpt-oss", "coder": "qwen", "reviewer": "gpt-oss" },
